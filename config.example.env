# teamwork-graph-mcp configuration. Copy to ~/.config/twg-mcp/teamwork-graph-mcp.env
# (mode 600) and point the systemd unit's EnvironmentFile= at it. Every variable
# is optional.

# Address and port the MCP server listens on. Keep it on the loopback
# interface and put a tunnel or reverse proxy in front for remote clients.
TWG_MCP_BIND=127.0.0.1
TWG_MCP_PORT=8772

# File holding the bearer secret (created by `twg-mcp --init-secret`).
TWG_MCP_SECRET_FILE=~/.config/twg-mcp/mcp-secret

# Public host names that reach this server, comma-separated, for example the
# hostname of a Cloudflare Tunnel route. Requests for any other Host get 421.
TWG_MCP_PUBLIC_HOSTS=

# The twg binary. Default: `twg` found on TWG_PATH.
TWG_BIN=

# HOME and PATH that twg runs with. Defaults: your home folder, and
# ~/.local/bin:/usr/local/bin:/usr/bin:/bin.
TWG_HOME=
TWG_PATH=

# twg's own config folder, if you keep it somewhere other than twg's default.
TWG_CONFIG_DIR=

# Optional: the Atlassian account twg is signed in as, shown to the model in the
# server instructions, e.g. you@example.com.
TWG_MCP_ACCOUNT_LABEL=
